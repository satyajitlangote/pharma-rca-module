# Copy to backend/.env and fill in. NEVER commit .env (it is gitignored).

# --- AI -------------------------------------------------------------------
# Groq API key from https://console.groq.com/keys
# If missing, every AI endpoint returns HTTP 503 ("AI unavailable").
GROQ_API_KEY=

# Default model; the UI may also pick another allowlisted model (server-side).
# Note: llama-3.3-70b-versatile / gemma2-9b-it are allowlisted but this Groq
# account may not serve them (404) — gpt-oss-20b is the verified default.
AI_MODEL=openai/gpt-oss-20b

# --- Database ---------------------------------------------------------------
# Primary: PostgreSQL from docker-compose (host port 5434 by default).
DATABASE_URL=postgresql+psycopg://aivoa:aivoa@127.0.0.1:5434/aivoa_rca
# Leave DATABASE_URL EMPTY to use the explicit SQLite dev fallback
# (backend/aivoa_rca.db). The UI shows a visible warning in that case.

# --- CORS -------------------------------------------------------------------
# Only these origins are allowed (never "*" with credentials).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Limits ------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880          # 5 MB per uploaded document
MAX_TEXT_CHARS=60000              # long documents are truncated with a visible warning
EXTRACTION_TEMPERATURE=0          # accuracy principle #7
ANALYSIS_TEMPERATURE=0.1
